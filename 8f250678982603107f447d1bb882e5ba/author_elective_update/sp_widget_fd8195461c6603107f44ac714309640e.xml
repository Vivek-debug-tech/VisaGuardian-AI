        <template><![CDATA[<div class="panel panel-default border-0 shadow-sm">
  <!-- Header -->
  <div class="panel-heading bg-primary-custom p-3">
    <h3 class="panel-title text-white m-n">
      <i class="fa fa-dashboard m-r-xs"></i> Student Services Dashboard
    </h3>
  </div>

  <div class="panel-body p-4">
    <div class="row">
      <!-- Left Column: Active Cases Data Table (60%) -->
      <div class="col-md-7">
        <div class="panel panel-bordered">
          <div class="panel-heading p-3 bg-white border-bottom">
            <h4 class="m-n text-dark bold">My Active Requests</h4>
          </div>
          <div class="table-responsive">
            <table class="table table-striped table-hover m-b-none">
              <thead>
                <tr class="bg-light">
                  <th class="text-dark">Case ID</th>
                  <th class="text-dark">Request Type</th>
                  <th class="text-dark">Status</th>
                  <th class="text-dark">Updated</th>
                  <th class="text-dark">Action</th>
                </tr>
              </thead>
              <tbody>
                <tr ng-repeat="item in c.cases">
                  <td><strong>{{item.number}}</strong></td>
                  <td>{{item.type}}</td>
                  <td><span class="label label-info">{{item.status}}</span></td>
                  <td>{{item.date}}</td>
                  <td>
                    <a href="/visaguardian?id=vg_digital_twin" class="btn btn-xs btn-default bold">View Twin</a>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Right Column: Important Deadlines & AI Assistant Card (40%) -->
      <div class="col-md-5">
        <div class="panel panel-bordered m-b-md">
          <div class="panel-heading p-3 bg-white border-bottom">
            <h4 class="m-n text-dark bold">
              <i class="fa fa-calendar text-primary m-r-xs"></i> Important Deadlines
            </h4>
          </div>
          <ul class="list-group list-group-flush m-b-none">
            <li class="list-group-item p-3" ng-repeat="d in c.deadlines">
              <span class="label pull-right {{d.urgency}}">{{d.date}}</span>
              <strong class="text-dark">{{d.title}}</strong>
            </li>
          </ul>
        </div>

        <!-- AI Assistant Callout Card -->
        <div class="well bg-primary-custom text-white p-3 text-center">
          <i class="fa fa-comments fa-2x m-b-xs"></i>
          <h4 class="text-white m-t-xs">Need Immigration Guidance?</h4>
          <p class="small text-light-blue">Ask VisaGuardian AI Agent for instant document checklists and policy answers.</p>
          <a href="/visaguardian?id=vg_ai_chat" class="btn btn-sm btn-light text-primary bold">Chat Now</a>
        </div>
      </div>
    </div>
  </div>
</div>]]></template>
