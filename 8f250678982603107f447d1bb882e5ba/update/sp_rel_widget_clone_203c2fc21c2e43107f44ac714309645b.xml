        <payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;sp_widget&gt;&lt;category&gt;custom&lt;/category&gt;&lt;client_script&gt;&lt;![CDATA[function() {
  	var c = this;
  	
	var rejectNote = "";
	c.resolveCase = function() {
		if (c.data.resolutionAction == "accept") 
			acceptResolution();
		else if (c.data.resolutionAction == "reject") {
			rejectNote = c.data.rejectResolutionNote.trim();
			rejectResolution();
		}
		$('#acceptRejectModal').modal('hide');
	}
	
	acceptResolution = function() {
		c.server.get({
			action: 'sendResponse',
			purpose: 'accept',
			state: 7,
			acceptResolutionNote: 'Resolution accepted, request closed.'
		});
	};
	
	rejectResolution = function() {
		c.server.get({
			action: 'sendResponse',
			purpose: 'reject',
			state: 2,
			state_reason: 1,
			rejectResolutionNote : rejectNote
		});
	};
	
	var cancelNote = "";
	c.cancelUR = function() {
		cancelNote = c.data.cancelNotes.trim();
		c.server.get({
			action: 'cancel', 
			cancelNote: cancelNote
		});
		$('#cancelModal').modal('hide');
	}
	
}]]&gt;&lt;/client_script&gt;&lt;controller_as&gt;c&lt;/controller_as&gt;&lt;css&gt;.dropdown {
