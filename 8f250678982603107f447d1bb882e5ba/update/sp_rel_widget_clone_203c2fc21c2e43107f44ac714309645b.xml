}&lt;/css&gt;&lt;data_table&gt;sp_instance&lt;/data_table&gt;&lt;demo_data/&gt;&lt;description&gt;This is an action widget for Universal Request that contains "Accept Resolution and Reject Resolution" options. &lt;/description&gt;&lt;docs/&gt;&lt;field_list/&gt;&lt;has_preview&gt;false&lt;/has_preview&gt;&lt;id&gt;action_widget_for_ur&lt;/id&gt;&lt;internal&gt;false&lt;/internal&gt;&lt;link&gt;&lt;![CDATA[function link(scope, element, attrs, controller) {

}]]&gt;&lt;/link&gt;&lt;name&gt;Action Widget for UR&lt;/name&gt;&lt;option_schema/&gt;&lt;public&gt;false&lt;/public&gt;&lt;roles/&gt;&lt;script&gt;&lt;![CDATA[(function() {
  	var tableName = $sp.getParameter('table');
	var sysId = $sp.getParameter('sys_id');
	
	var record = sn_std_tkt_api.TicketConfig.getTicketRecord(tableName, sysId);
	data.canRead = (record !== null &amp;&amp; record.isValid() &amp;&amp; record.canRead());
	if (!data.canRead)
		return;
	
	data.valid = false;
	data.showCancel = false;
	var hasPrimaryTask = record.primary_task;
	var state = record.state;
	var stateReason = record.state_reason;
	if (tableName === 'universal_request' &amp;&amp; !hasPrimaryTask &amp;&amp; record.active) {
		if (state == UniversalRequestStateSNC.AWAITING_RESPONSE_FROM_USER &amp;&amp; stateReason == UniversalRequestStateSNC.STATE_REASON.AWAITING_RESPONSE_FROM_USER.ACCEPT_RESOLUTION)
			data.valid = true;
		else {
			var universalRequestUtils = new UniversalRequestUtilsSNC();
			var taskGR = new GlideRecord(universalRequestUtils.TABLES.TASK);
			taskGR.query("universal_request",sysId);
			if(!taskGR.next())
				data.showCancel = true;
		}
	}
	
	if (input &amp;&amp; input.action === 'sendResponse' ) {
		var universalGr = new GlideRecord(tableName);
		var acceptNotes;
		if (universalGr.get(sysId)) {
			universalGr.setValue('state', input.state);
			if (input.purpose === 'accept') {
				acceptNotes = input.acceptResolutionNote;
				universalGr.comments = acceptNotes;
			}
			
			else if (input.purpose === 'reject') {
				universalGr.setValue('state_reason', input.state_reason);
				var rejectNotes = gs.getMessage('[code]&lt;b&gt; Reason for rejection: &lt;/b&gt;[/code] ') + input.rejectResolutionNote;
				universalGr.comments = rejectNotes;
			}
			var flag = universalGr.update();
			if (input.purpose === 'accept' &amp;&amp; flag)
				gs.addInfoMessage(acceptNotes);
		}
		return;
	}
	
	if(input &amp;&amp; input.action === 'cancel') {
		var universalGr = new GlideRecord(tableName);
		if(universalGr.get(sysId)) {
			universalGr.setValue('state', UniversalRequestStateSNC.CANCELED);
			var cancelNotes = input.cancelNote;
			if(cancelNotes) {
				universalGr.comments = cancelNotes;
				var canceled = universalGr.update();
				if (canceled)
					gs.addInfoMessage(gs.getMessage('{0} has been canceled',record.number));
			}
			else {
				gs.addErrorMessage(gs.getMessage("Please enter reason for closing request"));
				return;
			}
		}
	}
	
})();]]&gt;&lt;/script&gt;&lt;servicenow&gt;false&lt;/servicenow&gt;&lt;sys_class_name&gt;sp_widget&lt;/sys_class_name&gt;&lt;sys_created_by&gt;admin&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2020-02-10 11:23:55&lt;/sys_created_on&gt;&lt;sys_id&gt;6fbdb3be533200106d58ddeeff7b1214&lt;/sys_id&gt;&lt;sys_mod_count&gt;70&lt;/sys_mod_count&gt;&lt;sys_name&gt;Action Widget for UR&lt;/sys_name&gt;&lt;sys_package display_value="Universal Request" source="sn_uni_req"&gt;c1ddba4773b10010cbb654eb7df6a76b&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_scope display_value="Universal Request"&gt;c1ddba4773b10010cbb654eb7df6a76b&lt;/sys_scope&gt;&lt;sys_update_name&gt;sp_widget_6fbdb3be533200106d58ddeeff7b1214&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;admin&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2024-09-11 18:40:56&lt;/sys_updated_on&gt;&lt;template&gt;&lt;![CDATA[&lt;div class="dropdown" ng-if="data.valid"&gt;
  &lt;div class="col-xs-8 actions-pad text-center"&gt;
    	&lt;button class="btn btn-primary" data-toggle="modal" data-backdrop="false" data-target="#acceptRejectModal"&gt;${Accept/reject resolution} &lt;/button&gt;
  &lt;/div&gt; 
  &lt;div class="modal fade" id="acceptRejectModal" tabindex="-1" role="dialog" aria-label="${Accept/Reject actions modal}"&gt;
    &lt;div class="backdrop"&gt;&lt;/div&gt;
    &lt;div class="modal-dialog modalPosition" role="document"&gt;
        &lt;div class="modal-content"&gt;
            &lt;div class="modal-header modalHeader"&gt;
                &lt;button data-dismiss="GlideModal" class="btn btn-icon close crossButton icon-cross" data-dismiss="modal"&gt;
                    &lt;span class="sr-only"&gt;${Close}&lt;/span&gt;
                &lt;/button&gt;
                &lt;h1 class="modal-title modalTitle"&gt;${Do you accept or reject the resolution?}&lt;/h1&gt;
            &lt;/div&gt;
            &lt;div class="modal-body modalBody" aria-hidden="true"&gt;
              	&lt;div class="radio" ng-init="c.data.resolutionAction='accept'"&gt;
                  	&lt;label class="controls-radio textMargin"&gt;
                      &lt;input type="radio" name="resolutionAction" value="accept" ng-model="c.data.resolutionAction" checked&gt;
                      ${Yes, I accept the resolution. Close this request.}
                      &lt;span class="checkmark"&gt;&lt;/span&gt;
                  &lt;/label&gt;
              	&lt;/div&gt;
              	&lt;div class="radio"&gt;
                  	&lt;label class="controls-radio textMargin"&gt;
                      &lt;input type="radio" name="resolutionAction" value="reject" ng-model="c.data.resolutionAction"&gt;
                      ${No, I do not accept the resolution. I still need help.}
                      &lt;span class="checkmark"&gt;&lt;/span&gt;
	              		&lt;/label&gt;
              	&lt;/div&gt;
              	&lt;textarea maxlength="4000" ng-show="c.data.resolutionAction=='reject'" placeholder="${Please tell us what help you need?}" id="rejectResolutionNote" class="form-control" rows="5" ng-model="c.data.rejectResolutionNote"&gt;&lt;/textarea&gt;
              &lt;/div&gt;
            &lt;div class="modal-footer"&gt;
                &lt;button type="button" class="btn btn-default" data-dismiss="modal"&gt;${Cancel}&lt;/button&gt;
                &lt;button type="button" class="btn btn-primary" ng-disabled="c.data.resolutionAction == 'reject' &amp;&amp; !c.data.rejectResolutionNote" ng-click="c.resolveCase()"&gt;${ {{c.data.resolutionAction == "accept" ? "Accept": "Reject"}} resolution}&lt;/button&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
	&lt;/div&gt;
&lt;/div&gt;
&lt;div class="dropdown" ng-if="data.showCancel"&gt;
  &lt;div class="col-xs-8 actions-pad text-center"&gt;
    	&lt;button class="btn btn-default" data-toggle="modal" data-backdrop="false" data-target="#cancelModal"&gt;${Close} &lt;/button&gt;
  &lt;/div&gt; 
  &lt;div class="modal fade" id="cancelModal" tabindex="-1" role="dialog" aria-label="${Cancel Modal}"&gt;
    &lt;div class="backdrop"&gt;&lt;/div&gt;
     &lt;div class="modal-dialog modalPosition" role="document"&gt;
        &lt;div class="modal-content"&gt;
          &lt;div class="modal-body" style="padding:0"&gt;
            &lt;div class="modal-header" style="padding-top:0; padding-bottom:0"&gt;
              &lt;h1 class="h3 pull-left"&gt;${Close request}&lt;/h1&gt;
              &lt;span class="pull-right"&gt;
                    &lt;i class="fa fa-close pull-right text-base" autofocus="true" tabindex="0" data-dismiss="modal" aria-label="Close" role="button"&gt;
                    &lt;/i&gt;
                  &lt;/span&gt;
            &lt;/div&gt;
          	&lt;div class="modal-body modalBody" align="left"&gt;
          &lt;label class="field-label"&gt;
                &lt;span class="field-decorations"&gt;
              		&lt;span ng-class="{'mandatory-filled': c.data.cancelNotes}" class="fa fa-asterisk mandatory" aria-hidden="false"&gt;
                &lt;/span&gt;
                  &lt;/span&gt;
                  &lt;span id="requestCloseReason" class="ng-binding"&gt; ${Reason for closing request}
                &lt;/span&gt;
              &lt;/label&gt;
              	&lt;div class="text"&gt;
                  &lt;textarea maxlength="4000" placeholder="${}" id="cancelNote" class="form-control" rows="3" ng-model="c.data.cancelNotes" aria-required="true" aria-labelledby="requestCloseReason"&gt;&lt;/textarea&gt;
              	&lt;/div&gt;
            &lt;/div&gt;
            &lt;div class="modal-footer"&gt;
                &lt;button type="button" class="btn btn-default" data-dismiss="modal"&gt;${Cancel}&lt;/button&gt;
                &lt;button type="button" class="btn btn-primary" ng-disabled="!c.data.cancelNotes" ng-click="c.cancelUR()"&gt;${Close Request}&lt;/button&gt;
            &lt;/div&gt;
        	&lt;/div&gt;
       &lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;
]]&gt;&lt;/template&gt;&lt;/sp_widget&gt;</payload>
